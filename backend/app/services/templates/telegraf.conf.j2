# Generated by OpsPilot — DO NOT EDIT
# Server: {{ server_name }} ({{ server_id }})

[agent]
  interval = "10s"
  round_interval = true
  metric_batch_size = 1000
  metric_buffer_limit = 10000
  collection_jitter = "0s"
  flush_interval = "10s"
  flush_jitter = "0s"
  precision = ""
  hostname = "{{ server_name }}"
  omit_hostname = false

[global_tags]
  server_id = "{{ server_id }}"

# ── Output: push InfluxDB Line Protocol to OpsPilot backend over HTTPS ───────
[[outputs.http]]
  url = "{{ ingest_url }}/api/ingest/metrics"
  timeout = "10s"
  method = "POST"
  data_format = "influx"
  content_encoding = "gzip"
  [outputs.http.headers]
    Authorization = "Bearer {{ ingestion_token }}"
    Content-Type = "application/octet-stream"

# ── System inputs ────────────────────────────────────────────────────────────
[[inputs.cpu]]
  percpu = false
  totalcpu = true
  collect_cpu_time = false
  report_active = true

[[inputs.mem]]

[[inputs.disk]]
  ignore_fs = ["tmpfs", "devtmpfs", "devfs", "iso9660", "overlay", "aufs", "squashfs"]

[[inputs.diskio]]

[[inputs.net]]
  ignore_protocol_stats = true

[[inputs.system]]

[[inputs.processes]]

[[inputs.swap]]

[[inputs.kernel]]

[[inputs.linux_sysctl_fs]]
{% if mysql_dsn %}

# ── MySQL/MariaDB input (DBCredential present at onboarding time) ────────────
[[inputs.mysql]]
  servers = ["{{ mysql_dsn }}"]
  perf_events_statements_digest_text_limit = 120
  perf_events_statements_limit = 250
  perf_events_statements_time_limit = 86400
  table_schema_databases = []
  gather_table_schema = false
  gather_process_list = true
  gather_slave_status = true
  gather_innodb_metrics = true
  gather_event_waits = false
  gather_table_io_waits = false
  gather_index_io_waits = false
{% endif %}
