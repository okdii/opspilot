#!/usr/bin/env python3
"""OpsPilot agent — collects system service metrics and reports to backend."""
import json
import subprocess
import time
import urllib.request
import urllib.error

OPSPILOT_URL = "{{ base_url }}"
INGESTION_TOKEN = "{{ ingestion_token }}"
INTERVAL_SEC = 60

SERVICES = [
    {"name": "apache",     "aliases": ["apache2", "httpd"],                                    "proc_names": ["apache2", "httpd"]},
    {"name": "nginx",      "aliases": ["nginx"],                                               "proc_names": ["nginx"]},
    {"name": "mysql",      "aliases": ["mysql", "mysqld", "mariadb"],                          "proc_names": ["mysqld", "mariadbd"]},
    {"name": "php-fpm",    "aliases": ["php-fpm", "php8.1-fpm", "php8.2-fpm", "php7.4-fpm"], "proc_names": ["php-fpm", "php8.1-fpm", "php8.2-fpm", "php7.4-fpm"]},
    {"name": "postgresql", "aliases": ["postgresql", "postgres"],                              "proc_names": ["postgres"]},
    {"name": "redis",      "aliases": ["redis", "redis-server"],                               "proc_names": ["redis-server"]},
    {"name": "mongodb",    "aliases": ["mongod"],                                              "proc_names": ["mongod"]},
    {"name": "nodejs",     "aliases": ["node", "nodejs"],                                      "proc_names": ["node"]},
    {"name": "docker",     "aliases": ["docker"],                                              "proc_names": ["dockerd"]},
]


def _unit_state(unit):
    """Return (load_state, active_state) for a systemd unit."""
    try:
        r = subprocess.run(
            ["systemctl", "show", "--property=LoadState,ActiveState", unit],
            capture_output=True, text=True, timeout=5,
        )
        props = dict(
            line.split("=", 1) for line in r.stdout.strip().splitlines() if "=" in line
        )
        return props.get("LoadState", "not-found"), props.get("ActiveState", "unknown")
    except Exception:
        return "not-found", "unknown"


def _proc_stats(proc_names):
    try:
        import psutil
        targets = [p.lower() for p in proc_names]
        for proc in psutil.process_iter(["name", "cpu_percent", "memory_info", "create_time"]):
            try:
                pname = proc.info["name"].lower()
                if any(t in pname for t in targets):
                    cpu = proc.cpu_percent(interval=0.1)
                    mem_mb = round(proc.info["memory_info"].rss / (1024 * 1024), 2)
                    uptime = int(time.time() - proc.info["create_time"])
                    return {"cpu_pct": round(cpu, 2), "mem_mb": mem_mb, "uptime_seconds": uptime}
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                continue
    except ImportError:
        pass
    return {"cpu_pct": None, "mem_mb": None, "uptime_seconds": None}


def collect_services():
    results = []
    for svc in SERVICES:
        status = "not_installed"
        for alias in svc["aliases"]:
            load, active = _unit_state(alias)
            if load == "not-found":
                continue  # unit doesn't exist, try next alias
            if active == "active":
                status = "running"
            else:
                status = "stopped"
            break
        entry = {"name": svc["name"], "status": status}
        if status == "running":
            entry.update(_proc_stats(svc["proc_names"]))
        else:
            entry.update({"cpu_pct": None, "mem_mb": None, "uptime_seconds": None})
        results.append(entry)
    return results


def send_heartbeat(services):
    payload = json.dumps({"services": services}).encode()
    req = urllib.request.Request(
        OPSPILOT_URL.rstrip("/") + "/api/ingest/heartbeat",
        data=payload,
        headers={
            "Authorization": "Bearer " + INGESTION_TOKEN,
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            resp.read()
    except urllib.error.URLError:
        pass


def main():
    while True:
        services = collect_services()
        send_heartbeat(services)
        time.sleep(INTERVAL_SEC)


if __name__ == "__main__":
    main()
