# ── Multiline parser: group multi-line MariaDB slow-query blocks ──────────────
# A slow-query entry spans several lines and begins with "# Time:". Everything
# up to the next "# Time:" belongs to the same record, so the Log Viewer sees
# one entry per slow query (spec 05 §6.5) instead of one record per line.
[MULTILINE_PARSER]
    Name          mariadb_slow
    Type          regex
    Flush_timeout 1000
    Rule          "start_state"  "/^# Time:.*/"      "cont"
    Rule          "cont"         "/^(?!# Time:).*/"  "cont"
