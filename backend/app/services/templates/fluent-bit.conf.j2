# Generated by OpsPilot — DO NOT EDIT
# Server: {{ server_name }} ({{ server_id }})

[SERVICE]
    Flush         5
    Daemon        Off
    Log_Level     info
    HTTP_Server   Off
    Storage.path  /var/lib/fluent-bit/storage
    Storage.sync  normal
    Storage.checksum on
    # Multiline parsers must live in a parsers file (not inline) as of Fluent Bit v5.
    Parsers_File  parsers-opspilot.conf

# ── System log ───────────────────────────────────────────────────────────────
[INPUT]
    Name              tail
    Path              {{ syslog_path }}
    Tag               syslog
    DB                /var/lib/fluent-bit/syslog.db
    Skip_Long_Lines   On
    Refresh_Interval  5

# ── Auth log ─────────────────────────────────────────────────────────────────
[INPUT]
    Name              tail
    Path              {{ auth_log_path }}
    Tag               auth
    DB                /var/lib/fluent-bit/auth.db
    Skip_Long_Lines   On
    Refresh_Interval  5

# ── Nginx access ─────────────────────────────────────────────────────────────
[INPUT]
    Name              tail
    Path              /var/log/nginx/access.log
    Tag               nginx_access
    DB                /var/lib/fluent-bit/nginx_access.db
    Skip_Long_Lines   On

# ── Nginx error ──────────────────────────────────────────────────────────────
[INPUT]
    Name              tail
    Path              /var/log/nginx/error.log
    Tag               nginx_error
    DB                /var/lib/fluent-bit/nginx_error.db
    Skip_Long_Lines   On

# ── PHP-FPM ──────────────────────────────────────────────────────────────────
[INPUT]
    Name              tail
    Path              {{ php_fpm_log_path }}
    Tag               php_fpm
    DB                /var/lib/fluent-bit/php_fpm.db
    Skip_Long_Lines   On

# ── PHP app errors ───────────────────────────────────────────────────────────
[INPUT]
    Name              tail
    Path              /var/log/php_errors.log
    Tag               php_app
    DB                /var/lib/fluent-bit/php_app.db
    Skip_Long_Lines   On

# ── MariaDB error ────────────────────────────────────────────────────────────
[INPUT]
    Name              tail
    Path              {{ mariadb_error_path }}
    Tag               mariadb_error
    DB                /var/lib/fluent-bit/mariadb_error.db
    Skip_Long_Lines   On

# ── MariaDB slow query ───────────────────────────────────────────────────────
[INPUT]
    Name              tail
    Path              {{ mariadb_slow_path }}
    Tag               mariadb_slow
    DB                /var/lib/fluent-bit/mariadb_slow.db
    Skip_Long_Lines   On
    Multiline.parser  mariadb_slow

# ── Tag server_id onto every record ──────────────────────────────────────────
[FILTER]
    Name    modify
    Match   *
    Add     server_id {{ server_id }}

# ── Stamp the log source (the input's tag) onto every record ─────────────────
# The http/json output drops the Fluent Bit tag, so without this the backend
# can't categorise logs and every record falls back to source="unknown".
[FILTER]
    Name   lua
    Match  *
    call   set_source
    code   function set_source(tag, ts, record) record['source'] = tag; return 1, ts, record end

# ── Output: push to OpsPilot backend over HTTPS ──────────────────────────────
[OUTPUT]
    Name              http
    Match             *
    Host              {{ ingest_host }}
    Port              {{ ingest_port }}
    URI               /api/ingest/logs
    Format            json
    json_date_key     time
    json_date_format  iso8601
    tls               {{ ingest_tls }}
    tls.verify        On
    Header            Authorization Bearer {{ ingestion_token }}
    Retry_Limit       5
