# OpsPilot environment configuration
# Copy to .env and fill in values before running `docker compose up`

# ── Database (PostgreSQL + TimescaleDB) ──────────────────────────────────────
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change-me-strong-password

# Telegraf write-only user (set during migration; Phase 3 uses it in agent configs)
# Generate with: openssl rand -base64 24
OPSPILOT_WRITER_PASSWORD=change-me-writer-password

# ── Secrets ──────────────────────────────────────────────────────────────────
# JWT signing key — min 32 chars
# Generate with: openssl rand -hex 32
OPSPILOT_JWT_SECRET=change-me-min-32-character-random-string-required

# Master AES-256 encryption key — exactly 32 bytes, base64 encoded
# Generate with: openssl rand -base64 32
# WARNING: if lost, all encrypted secrets (SSH keys, DB passwords) are unrecoverable
OPSPILOT_ENCRYPTION_KEY=base64-encoded-32-byte-key-here=

# ── Optional ─────────────────────────────────────────────────────────────────
# Base URL for outbound emails and ping URLs (falls back to request host if blank)
OPSPILOT_BASE_URL=

# Set to true ONLY for local dev (omits Secure flag from cookies)
DEBUG=false
